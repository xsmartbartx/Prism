# Optional overrides for deploy/nexora/compose.yml on the NEXORA host. None of these is a secret
# the stack needs: the database password and Prism's secret key are generated inside Docker
# volumes on first start. Only create the file if you want to change a default.
#
# PRISM_DOMAIN=prism.onenexora.com
# PRISM_VERSION=1.0.1
# PRISM_LICENSE_KEY=
# PRISM_MAX_UPLOAD_MB=100
