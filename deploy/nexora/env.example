# /opt/prism/.env on the NEXORA host (chmod 600). Generate secrets with: openssl rand -hex 32
PRISM_DOMAIN=prism.onenexora.com
PRISM_VERSION=1.0.1
POSTGRES_PASSWORD=
PRISM_SECRET_KEY=
# Optional: a Pro/Business key for this hosted instance (empty = Community limits).
PRISM_LICENSE_KEY=
PRISM_MAX_UPLOAD_MB=100
