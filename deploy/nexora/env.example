# Optional overrides for deploy/nexora/compose.yml on the NEXORA host. The stack needs no
# secrets file: the database password and Prism's secret key are generated inside Docker volumes
# on first start. Only create this file to change a default.
#
# PRISM_LICENSE_KEY is sensitive (anyone holding it can reuse your plan). If you set it, create
# the file owner-only before adding the key:  install -m 600 /dev/null <file>
#
# PRISM_DOMAIN=prism.onenexora.com
# PRISM_VERSION=1.0.1
# PRISM_LICENSE_KEY=
# PRISM_MAX_UPLOAD_MB=100
