# Copy to deploy/.env and fill in. Never commit the copy.

# --- Required ---------------------------------------------------------
# Public hostname. DNS must point here; Caddy obtains HTTPS certificates.
PRISM_DOMAIN=analytics.example.com
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=admin@example.com

# --- Recommended ------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PRISM_SECRET_KEY=

# Pro / Business license key (or paste it in Settings -> License).
PRISM_LICENSE_KEY=

# --- Optional ---------------------------------------------------------
PRISM_MAX_UPLOAD_MB=100
PRISM_BACKUP_KEEP=14
PRISM_MEMORY_LIMIT=2g

# PostgreSQL (start with: docker compose --profile postgres up -d)
# POSTGRES_PASSWORD=change-me
# PRISM_DATABASE_URL=postgresql+psycopg://prism@postgres:5432/prism   (password is taken from POSTGRES_PASSWORD)
